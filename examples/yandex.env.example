# Копируйте значения только в локальный файл вне Git и задайте ему права 0600.

# Яндекс.Директ: выберите ровно одну среду.
YANDEX_DIRECT_ENVIRONMENT=sandbox
# Нужен только представителю агентства; прямой рекламодатель оставляет пустым.
YANDEX_DIRECT_CLIENT_LOGIN=
YANDEX_DIRECT_SANDBOX_TOKEN=
# YANDEX_DIRECT_PRODUCTION_READ_TOKEN=
YANDEX_DIRECT_OUTPUT_DIR=.codex/direct-output
YANDEX_DIRECT_ACCESS_FILE=.codex/direct-access.json

# Метрика. Токен создаёт общий запуск авторизации.
YANDEX_METRIKA_TOKEN=
YANDEX_METRIKA_ACCESS_FILE=.codex/metrika-access.json
YANDEX_METRIKA_COUNTER_ID=

# Wordstat API v2 (Yandex Cloud Search API).
YANDEX_WORDSTAT_API_KEY=
YANDEX_WORDSTAT_FOLDER_ID=

# Поиск Яндекса: используйте ключ API либо IAM-токен, но не оба.
YANDEX_SEARCH_FOLDER_ID=
YANDEX_SEARCH_API_KEY=
# YANDEX_SEARCH_IAM_TOKEN=
YANDEX_SEARCH_ROUTE=disabled
# YANDEX_SEARCH_APPROVAL_FILE=.codex/search-approval.json
# YANDEX_SEARCH_USAGE_LEDGER=.codex/search-usage.json

# Необязательное собственное приложение OAuth. Обычным пользователям не нужно:
# встроенные опубликованные приложения Директа и Метрики уже сохранены в пакете.
# YANDEX_OAUTH_CONFIG_FILE=.codex/yandex-oauth-custom.json
YANDEX_AUTH_OUTPUT_DIR=.codex/auth

# Необязательная запись в YouGile. Не включайте вооружение постоянно.
# YOUGILE_WRITE_API_KEY=
YOUGILE_WRITE_ARMED=0
